# Live smoke-test credentials for the StackQL jira provider (copy to .env -
# gitignored - and fill in). `make smoke*` and `make survey-pagination`
# source .env when present. Never point this at a production site: use a
# dedicated trial or free Jira Cloud site.
#
# Never a real value in this file.

# The OAuth 2.0 credential of an Atlassian service account (Atlassian
# Administration > Directory > Service accounts > Create credentials >
# OAuth 2.0). The provider uses the client credentials grant against
# https://auth.atlassian.com/oauth/token. The credential's scopes are chosen
# when it is created: the classic Jira scopes (read:jira-work, write:jira-work,
# read:jira-user, manage:jira-project, manage:jira-configuration) cover the
# platform services; the agile service also needs the granular
# *:jira-software scopes (read:board-scope:jira-software, read:sprint:jira-software,
# write:sprint:jira-software, ...). The smoke suite reports the agile reads as
# SKIP when they are missing.
ATLASSIAN_CLIENT_ID=replace_with_service_account_client_id
ATLASSIAN_CLIENT_SECRET=replace_with_service_account_client_secret

# The cloud ID of the site: resolves the cloud_id server variable
# (x-stackQL-envVar) of every service except atlassian_tenant. Look it up with
#   SELECT cloud_id FROM jira.atlassian_tenant.info WHERE site = '<site>';
# (<site> is the subdomain of https://<site>.atlassian.net).
ATLASSIAN_CLOUD_ID=replace_with_site_cloud_id

# Optional: the project key the smoke suite works in (default SQLUAT). It is
# created on the first run if it does not exist (a Jira administrator
# identity is needed once), with the identity as lead and in its
# Administrators role.
#JIRA_SMOKE_PROJECT=SQLUAT
